{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run-debug-android",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "-t:Run",
                "${workspaceFolder}/gip.mes.client.avui.Android/gip.mes.client.avui.Android.csproj",
                "-p:TargetFramework=net10.0-android",
                "-p:Configuration=Debug",
                "-p:AndroidAttachDebugger=true",
                "-p:AndroidSdbHostPort=10000",
                "-p:AndroidSdbTargetPort=10000"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Forward Android debugger port",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "adb shell am force-stop com.CompanyName.gip.iplus.client.avui && adb shell setprop debug.mono.extra 'debug=127.0.0.1:10000,timeout=$(($(date +%s)+86400)),loglevel=0,server=y' && adb forward tcp:10000 tcp:10000 && adb shell am start -n com.CompanyName.gip.iplus.client.avui/crc64dbf5ba2d7712a4dc.MainActivity"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build Avalonia Desktop",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/gip.mes.client.avui.Desktop/gip.mes.client.avui.Desktop.csproj",
                "/p:Configuration=Debug"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Avalonia Desktop Release",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/gip.mes.client.avui.Desktop/gip.mes.client.avui.Desktop.csproj",
                "/p:Configuration=Release"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Windows (wine)",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/gip.mes.client/gip.mes.client.csproj",
                "-r",
                "win-x64",
                "/p:Configuration=Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Windows Release (wine)",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "${workspaceFolder}/gip.mes.client/gip.mes.client.csproj",
                "-r",
                "win-x64",
                "/p:Configuration=Release"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}